# services/ endpoints MUST be web-executable (Android app posts here).
# Deny raw-file access and directory listings, but allow PHP execution.

Options -Indexes

<FilesMatch "\.(md|txt|log|ini|sql|bak|orig|dist|json|lock|yml|yaml)$">
    Require all denied
</FilesMatch>

# Keep PHP execution ON (do NOT add php_flag engine off here)