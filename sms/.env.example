# Copy this file to ".env" and fill in real values.
# .env is git-ignored and MUST NOT be committed.
# Secrets are loaded by config.php via getenv().

# Application environment
APP_ENV=production

# Database credentials
DB_SERVER=localhost
DB_PORT=3306
DB_USER=ismsgateway_pro
DB_PASS=change_me_strong_password
DB_NAME=ismsgateway_pro

# Application secret used for sessions, device tokens and HMAC signing.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=change_me_to_a_random_64_hex_chars

# Session cookie name
APP_SESSION_NAME=SMS_GATEWAY

# Timezone (must be a valid PHP timezone identifier)
TIMEZONE=UTC

# Force HTTPS links even if the proxy doesn't set forwarded headers correctly
FORCE_HTTPS=false

# Comma-separated list of trusted proxy IPs allowed to set X-Forwarded-* headers
TRUSTED_PROXIES=

# Allowed Host header values (defense against Host-header injection).
# Leave empty to allow the configured server name only (recommended).
ALLOWED_HOSTS=

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# License / purchase code (leave as-is if not using license checks)
PURCHASE_CODE=c665693d-3923-4950-85b9-190858c451cb